# ── 慢道 LLM 配置（OpenAI 兼容 API：OpenAI / DeepSeek / Qwen / Moonshot 等） ──
# 不配置 OPENAI_API_KEY 时，慢道两拍自动使用确定性启发式（mock），
# 系统仍可端到端运行；管线四拍拓扑不变。
OPENAI_API_KEY=...
# 必须指向 Chat Completions API 根（通常以 /v1 结尾）；不要填网关网站首页
OPENAI_BASE_URL=https://dev.nextopenai.com/v1
VIZGUIDE_MODEL=gpt-4o-mini

# 多模态审图（gpt-4o-mini 支持 image_url）；默认与 VIZGUIDE_MODEL 相同
# VIZGUIDE_VISION_MODEL=gpt-4o-mini
# off | auto（live 时启用；默认服务端 VL→PNG）| on
# VIZGUIDE_VISION_MODE=auto
# 服务端用 vl-convert 渲染 working spec（1=开，0=关）；前端无需传图
# VIZGUIDE_VISION_SERVER_RENDER=1
# VIZGUIDE_VL_RENDER_SCALE=1
# 渲染/覆盖图 data URL 字符上限（默认约 3.5MB）
# VIZGUIDE_PREVIEW_IMAGE_MAX_CHARS=3500000

# auto = 有 key 走 live，无 key 走 mock；也可强制 live / mock
VIZGUIDE_LLM_MODE=live

# 每次 LLM API 往返落盘：advisor → storage/runs/{run_id}.llm.jsonl；其它 → llm_logs/
# VIZGUIDE_LLM_LOG=1

# Parser live 分块字符上限；兼容网关长请求超时时可继续调低（范围 1000–12000）
VIZGUIDE_PARSER_CHUNK_CHARS=3000

# mock 慢道每拍演示延时（毫秒），便于前端观察四拍推进；测试时设 0
VIZGUIDE_MOCK_BEAT_DELAY_MS=0

# L2 prefer 落地策略：suggest（默认：仅 chart.type 建议；其它可编译 prefer 仍执行）
# | apply（所有可编译 prefer 与 set 同权；chart.type 还须开启下方独立开关）
# VIZGUIDE_PREFER_MODE=suggest
# 兼容旧名：VIZGUIDE_CHART_TYPE_PREFER_MODE

# Persona 是否允许自动改图型：locked（默认，只返回建议）| allow。
# 用户明确提出的图型编辑不受此开关限制。
VIZGUIDE_ADVISOR_CHART_TYPE_MODE=locked

# 可选覆盖：persona 数据目录与运行时存储目录
# VIZGUIDE_DATA_DIR=../data
# VIZGUIDE_STORAGE_DIR=./storage

# 前端来源（CORS），默认已含 vite dev 端口
# VIZGUIDE_CORS_ORIGINS=http://localhost:5173
